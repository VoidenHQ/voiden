{
  "name": "@voiden/executors",
  "version": "0.1.7",
  "description": "Shared protocol executors for Voiden — REST, WebSocket, gRPC, MCP",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/VoidenHQ/voiden",
    "directory": "packages/executors"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.10.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "mime-types": "^2.1.35",
    "ws": "^8.17.0",
    "yaml": "^2.4.2"
  },
  "devDependencies": {
    "@types/mime-types": "^2.1.4",
    "@types/node": "^20.14.10",
    "@types/ws": "^8.5.10",
    "typescript": "^5.5.3"
  }
}
