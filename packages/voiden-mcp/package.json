{
  "name": "@voiden/mcp",
  "version": "0.0.14",
  "description": "Runs .void /tool blocks as a live MCP server — discovery, verification, health checks, graceful shutdown, optional public tunnel. The actual MCP server process, not a CLI action; the `voiden` CLI's `agent` command registers a project to launch it, but never wraps or duplicates its logic.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/VoidenHQ/voiden",
    "directory": "packages/voiden-mcp"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "voiden-mcp": "./dist/index.js"
  },
  "main": "./dist/lib.js",
  "types": "./dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "smoke-test": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@voiden/runner": "workspace:*",
    "commander": "^12.0.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^20.14.10",
    "tsx": "^4.15.0",
    "typescript": "^5.5.3"
  }
}
